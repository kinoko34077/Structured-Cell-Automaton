{
  "schema_version": 1,
  "project": {
    "name": "Structured-Cell-Automaton",
    "type": "streamlit-app",
    "description": "Streamlit GUI prototype for structured cell syntax generation, evolution, and visualization."
  },
  "profile": "web-app",
  "profiles": [
    "web-app"
  ],
  "runtime": {
    "modules": []
  },
  "surfaces": {
    "cli": false,
    "gui_windows": false,
    "web": true,
    "api": false,
    "mcp": false,
    "agent": false,
    "library": false
  },
  "commands": {
    "setup": {
      "exec": "python",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "cwd": ".",
      "forward_args": false
    },
    "dev": {
      "exec": "streamlit",
      "args": ["run", "sca_gui.py"],
      "cwd": ".",
      "forward_args": false
    },
    "test": {
      "exec": "python",
      "args": ["-m", "unittest", "discover", "-s", "project/tests", "-v"],
      "cwd": ".",
      "forward_args": false
    },
    "build": "",
    "verify": {
      "exec": "python",
      "args": ["-m", "unittest", "discover", "-s", "project/tests", "-v"],
      "cwd": ".",
      "forward_args": false
    },
    "smoke": "",
    "deploy": ""
  },
  "paths": {
    "docs": "docs/",
    "actions": "contracts/actions.json",
    "surfaces": "contracts/surfaces.json",
    "defaults": "defaults.json"
  },
  "notes": [
    "This adoption adds the KiNoTch Base and Project Overlay without moving Streamlit or Domain files.",
    "Streamlit UI, data files, persistence, and visualization remain Project-owned.",
    "Project-owned verification uses Streamlit AppTest to exercise sequential GUI reruns and session-state behavior."
  ]
}
